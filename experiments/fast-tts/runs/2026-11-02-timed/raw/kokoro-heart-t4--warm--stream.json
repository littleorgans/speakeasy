     "index": 0,
     "readyMs": 375.758,
     "audioMs": 1144.833,
     "text": "I finished reading the"
    },
    {
     "index": 1,
     "readyMs": 932.466,
     "audioMs": 1918.208,
     "text": "three papers you flagged last night."
    },
    {
     "index": 2,
     "readyMs": 2412.745,
     "audioMs": 5903.625,
     "text": "The first one claims a forty percent speed up, but only on short prompts, and their test machine had twice our memory."
    },
    {
     "index": 3,
     "readyMs": 3924.206,
     "audioMs": 6165.083,
     "text": "The second paper is more useful: it shows that splitting text at commas cuts the wait before speech by about half."
    },
    {
     "index": 4,
     "readyMs": 4821.764,
     "audioMs": 3536.667,
     "text": "The third is mostly a survey, so I only kept the summary table."
    },
    {
     "index": 5,
     "readyMs": 6288.337,
     "audioMs": 5527.625,
     "text": "Overall, I think the comma trick is worth trying first, because it needs no new model and could ship in a day."
    },
    {
     "index": 6,
     "readyMs": 7567.905,
     "audioMs": 4864.583,
     "text": "I wrote up the details in the research folder, with links to each paper and the numbers I checked."
    },
    {
     "index": 7,
     "readyMs": 8467.267,
     "audioMs": 3648,
     "text": "Tell me if you want a shorter version for the team update on Monday."
    }
   ]
