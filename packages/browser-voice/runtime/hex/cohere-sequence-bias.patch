+// Names bias (TRANSCRIBE_EXT_KIND_COHERE_SEQUENCE_BIAS): every nonempty
+// prefix of each supplied token sequence, shared prefixes deduplicated; a
+// token whose preceding generated tokens complete a prefix gains `amount`
+// once per matching prefix. Bias zero keeps the GPU argmax and never reads
+// logits back.
+struct SequenceBias {
+    float amount = 0.0f;
+    std::vector<std::vector<int>> sequences;
+
+    static transcribe_status from_params(const transcribe_run_params * params, int vocab, SequenceBias & out) {
+        out = SequenceBias{};
+        if (params == nullptr || params->family == nullptr) return TRANSCRIBE_OK;
+        if (const transcribe_status st = transcribe_ext_check(params->family, TRANSCRIBE_EXT_KIND_COHERE_SEQUENCE_BIAS,
+                                                              sizeof(struct transcribe_cohere_sequence_bias_ext));
+            st != TRANSCRIBE_OK) {
+            return st;
+        }
+        const auto * ext = reinterpret_cast<const transcribe_cohere_sequence_bias_ext *>(params->family);
+        if (!std::isfinite(ext->bias) || ext->n_sequences < 0 ||
+            (ext->n_sequences > 0 && (ext->tokens == nullptr || ext->lengths == nullptr))) {
+            return TRANSCRIBE_ERR_INVALID_ARG;
+        }
+        if (ext->bias == 0.0f) return TRANSCRIBE_OK;
+        const int32_t * next = ext->tokens;
+        for (int32_t s = 0; s < ext->n_sequences; ++s) {
+            if (ext->lengths[s] <= 0) return TRANSCRIBE_ERR_INVALID_ARG;
+            std::vector<int> ids(next, next + ext->lengths[s]);
+            next += ext->lengths[s];
+            for (int id : ids) if (id < 0 || id >= vocab) return TRANSCRIBE_ERR_INVALID_ARG;
+            for (size_t end = 1; end <= ids.size(); ++end) {
+                std::vector<int> prefix(ids.begin(), ids.begin() + end);
+                if (std::find(out.sequences.begin(), out.sequences.end(), prefix) == out.sequences.end())
+                    out.sequences.push_back(std::move(prefix));
+            }
+        }
+        if (out.sequences.empty()) return TRANSCRIBE_ERR_INVALID_ARG;
+        out.amount = ext->bias;
+        return TRANSCRIBE_OK;
+    }
+
+    int select(ggml_tensor * logits, size_t offset, const std::vector<int> & generated) const {
+        const size_t vocab = static_cast<size_t>(logits->ne[0]);
+        std::vector<float> scores(vocab), bias(vocab, 0.0f);
+        ggml_backend_tensor_get(logits, scores.data(), offset * vocab * sizeof(float), vocab * sizeof(float));
+        for (const auto & ids : sequences) {
+            const size_t prefix = ids.size() - 1;
+            if (static_cast<size_t>(ids.back()) < vocab && generated.size() >= prefix &&
+                std::equal(ids.begin(), ids.end() - 1, generated.end() - prefix))
+                bias[ids.back()] += amount;
+        }
+        for (size_t i = 0; i < vocab; ++i) scores[i] += bias[i];
+        return static_cast<int>(std::max_element(scores.begin(), scores.end()) - scores.begin());
+    }
+};
