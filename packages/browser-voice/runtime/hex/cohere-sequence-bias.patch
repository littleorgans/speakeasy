index 0000000..49e2c31
--- /dev/null
+++ b/include/transcribe/cohere.h
@@ -0,0 +1,47 @@
+/*
+ * include/transcribe/cohere.h - Cohere ASR family public extension surface.
+ *
+ * Includes transcribe.h; safe to include in C or C++ TUs.
+ */
+
+#ifndef TRANSCRIBE_COHERE_H
+#define TRANSCRIBE_COHERE_H
+
+#include "transcribe.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 'CHSB' little-endian = 0x42534843 */
+#define TRANSCRIBE_EXT_KIND_COHERE_SEQUENCE_BIAS 0x42534843u
+
+/*
+ * Sequence bias for the greedy decoder (run slot; transcribe_run only,
+ * transcribe_run_batch rejects it). Every nonempty prefix of each sequence
+ * is a rule, shared prefixes once: a token gains `bias` in logits for each
+ * rule it completes after the generated tokens before it (the Transformers
+ * `sequence_bias` meaning). Prompt tokens are not history.
+ *
+ *   bias         Logits added per matching rule. 0 turns biasing off and
+ *                keeps the GPU argmax path.
+ *   tokens       All sequences' token ids, concatenated.
+ *   lengths      Each sequence's length, > 0.
+ *   n_sequences  Number of sequences.
+ */
+struct transcribe_cohere_sequence_bias_ext {
+    struct transcribe_ext ext;
+    float                 bias;
+    const int32_t *       tokens;
+    const int32_t *       lengths;
+    int32_t               n_sequences;
+};
+
+/* Fills ext.size/kind, bias = 0 (off), and no sequences. */
+TRANSCRIBE_API void transcribe_cohere_sequence_bias_ext_init(struct transcribe_cohere_sequence_bias_ext * ext);
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+
+#endif /* TRANSCRIBE_COHERE_H */
